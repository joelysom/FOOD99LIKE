rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isKnownRestaurant(restaurantId) {
      return restaurantId == 'tokka-foods'
        || (
          firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
          && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.active == true
        );
    }

    function isRestaurantAdmin(restaurantId) {
      return isKnownRestaurant(restaurantId)
        && isSignedIn()
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId)/admins/$(request.auth.uid));
    }

    match /cards/profiles/{userId}/avatar {
      allow read: if firestore.exists(/databases/(default)/documents/cardsProfiles/$(userId))
        && firestore.get(/databases/(default)/documents/cardsInventory/$(firestore.get(/databases/(default)/documents/cardsProfiles/$(userId)).data.cardId)).data.status == 'ativado';
      allow write: if isSignedIn() && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/cardsProfiles/$(userId))
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if isKnownRestaurant(restaurantId);
      allow write: if isRestaurantAdmin(restaurantId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
