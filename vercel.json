{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/cards",
      "destination": "https://tokka-cards-api.vercel.app/api/cards"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
