{
  "name": "food99like-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test:menu": "node --experimental-vm-modules --test tests/menuPersistence.test.mjs",
    "test:production": "npm run build && playwright test --config tests/production.playwright.config.mjs",
    "firebase": "firebase",
    "firebase:login": "firebase login",
    "firebase:logout": "firebase logout",
    "firebase:projects": "firebase projects:list",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,storage",
    "firebase:create-admin": "node scripts/create-default-admin.mjs",
    "firebase:create-restaurant": "node scripts/create-restaurant.mjs",
    "firebase:deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:storage-rules": "firebase deploy --only storage",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy": "npm run build && firebase deploy",
    "test:cards": "node --test tests/cards.routes.test.mjs",
    "test:cards:http": "node --test tests/cards.http.test.mjs",
    "cards:api": "node scripts/start-cards-api.mjs",
    "cards:prepare-backend": "node scripts/prepare-cards-backend.mjs",
    "test:cards:integration": "node scripts/test-cards.mjs",
    "test:cards:browser": "node scripts/test-cards.mjs --browser",
    "firebase:grant-cards-admin": "node scripts/grant-cards-admin.mjs",
    "firebase:import-cards": "node scripts/import-cards.mjs",
    "firebase:deploy:cards": "firebase deploy --project cards --only functions:tokka-cards,firestore:rules,storage"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "cropperjs": "^1.6.2",
    "firebase": "^12.17.1",
    "jszip": "^3.10.2",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "firebase-tools": "^15.27.0",
    "globals": "latest"
  }
}
